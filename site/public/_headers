/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://divulgacandcontas.tse.jus.br; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
